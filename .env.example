# Cognitive Router Proxy — Environment Variables

# Provider API keys
ZAI_API_KEY=your_zai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GEMINI_API_KEY=your_gemini_key_here
# Ollama runs locally — no key needed

# Provider base URLs (override if you use a different endpoint or proxy)
# ZAI has two endpoints: /api/coding/paas/v4 (coding plan keys) and /api/paas/v4 (general keys)
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OLLAMA_BASE_URL=http://localhost:11434/v1

# Proxy configuration
ROUTER_PORT=3456
ROUTER_LOG_LEVEL=info
ROUTER_DB_PATH=data/cognitive-router.db

# Provider priority order (comma-separated, lower index = tried first)
ROUTER_PRIORITY=zai,openrouter,gemini,ollama

# Max VRAM for local models (GB) — models exceeding this are filtered out
ROUTER_VRAM_LIMIT=11

# Per-provider attempt timeouts (milliseconds)
# Keep these lower than the OpenClaw LLM request timeout so CogRouter can fail over first.
ROUTER_REQUEST_TIMEOUT_MS=55000
ROUTER_REMOTE_TIMEOUT_MS=12000
ROUTER_LOCAL_TIMEOUT_MS=20000
ROUTER_REMOTE_STREAM_TIMEOUT_MS=60000
ROUTER_LOCAL_STREAM_TIMEOUT_MS=60000

# Number of models to try within one provider before moving to the next provider.
ROUTER_MAX_ATTEMPTS_PER_PROVIDER=1

# Explicit fallback models used when a provider has no seeded registry model.
# Tool requests prefer provider priority order. Gemini is tool-capable, and
# Ollama is allowed only for explicitly listed local tool-capable models.
ROUTER_OPENROUTER_TOOL_MODEL=qwen/qwen3-coder:free
ROUTER_OPENROUTER_FALLBACK_MODEL=openrouter/owl-alpha
ROUTER_GEMINI_TOOL_MODEL=gemini-2.5-flash
ROUTER_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
ROUTER_OLLAMA_TOOL_MODELS=gemma4:latest

# ─── LLM-as-Judge Feedback Loop ───
# After a fraction of successful responses, a judge model scores the quality.
# Scores feed back into model capability data via EMA, evolving over time.
# Set sample rate to 0 to disable.
# Judge = Gemini 3.5 Flash (direct Gemini provider ID — NOT an OpenRouter ID).
# Self-recusal is family-wide: a Gemini judge never grades Gemini candidates.
ROUTER_JUDGE_SAMPLE_RATE=0.10
ROUTER_JUDGE_PROVIDER=gemini
ROUTER_JUDGE_MODEL=gemini-3.5-flash
ROUTER_JUDGE_MIN_LENGTH=50
# Ingestion ladder tier caps (chars): tier1 single-shot; tier2 multi-turn
# chunked; tier3 head+tail with explicit elision markers. 3.5:1 chars/token.
ROUTER_JUDGE_MAX_CHARS=32000
ROUTER_JUDGE_TIER2_MAX_CHARS=200000
ROUTER_JUDGE_CHARS_PER_TOKEN=3.5
ROUTER_JUDGE_TIMEOUT_MS=15000

# ─── Learning-Loop Hardening (Phase 1) ───
# Shadow mode: learner logs would-be values to shadow_decisions and NEVER
# writes capability_overrides while true. Flip to false ONLY after the shadow
# gates pass (scripts/verify_shadow_gates.ts) — a human decision.
ROUTER_LEARNING_SHADOW_MODE=true
# Attribution gate: Arm B fires (no_apply) when classifier confidence is below
# this bar. Spike-verified Aug 24: 0.75 catches the poisoned status-log cluster.
ROUTER_ARM_B_MIN_CONFIDENCE=0.75
# Quarantine: identical normalized judge note seen this many times historically
# → pair quarantined + alert (canary); pre-application hold threshold.
ROUTER_JUDGE_NOTE_CANARY=5
ROUTER_JUDGE_NOTE_HOLD=1
# Guardrails: hard clamps [min,max] at write time; rate-of-change caps per
# 24h/7d windows (atomic BEGIN IMMEDIATE transaction); decay-to-prior after N
# idle days at the given daily rate (pinned cells exempt).
ROUTER_CAP_MIN=0.05
ROUTER_CAP_MAX=0.98
ROUTER_ROC_MAX_24H=0.15
ROUTER_ROC_MAX_7D=0.30
ROUTER_DECAY_IDLE_DAYS=14
ROUTER_DECAY_RATE=0.10
# UCB exploration bonus k (learned + k/√n, n=0→1) — offline-tuned vs the
# 1,132 judge_history evals; see docs/TUNING_LOG.md. No live tuning.
ROUTER_UCB_K=0.02

# Admin restart bridge: gates POST /admin/restart (generate your own)
ROUTER_ADMIN_TOKEN=change-me

# Central-server mode: bind host (default 127.0.0.1 = loopback-only, auth off).
# Non-loopback binds REQUIRE ROUTER_API_KEYS — the router refuses to start otherwise.
ROUTER_BIND_HOST=127.0.0.1
# Comma-separated inbound Bearer keys (Authorization: Bearer <key>). Empty = auth disabled.
ROUTER_API_KEYS=

# ----- Model discovery modes (2026-09-06) -----
# auto   - discover on startup + hourly + admin hook (all keyed providers)
# safe   - discover on startup + admin hook only (DEFAULT)
# manual - no endpoint discovery; only ROUTER_MANUAL_MODELS slugs register
#ROUTER_DISCOVERY_MODE=safe
# Comma-separated "provider/model" slugs (manual mode)
#ROUTER_MANUAL_MODELS=anthropic/claude-opus-4-5,anthropic/claude-sonnet-4
# Refresh interval for auto mode (minutes, min 5)
#ROUTER_DISCOVERY_INTERVAL_MINUTES=60

# ----- Benchmark judge (steers only the benchmark ladder's judge calls) -----
# Independent of ROUTER_JUDGE_* (live traffic judge). Current policy: ZAI
# (coding-plan subscription = no marginal spend) until the system is proven.
#ROUTER_BENCH_JUDGE_PROVIDER=zai
#ROUTER_BENCH_JUDGE_MODEL=glm-5.2
